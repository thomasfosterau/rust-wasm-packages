{
  "$schema": "https://www.schemastore.org/package",
  "name": "rust-wasm-packages-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Rust crates made available to JavaScript via WebAssembly",
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/rust-wasm-packages.git"
  },
  "type": "module",
  "scripts": {
    "check": "vp check",
    "test": "vp run -r test",
    "build": "vp run -r build",
    "clean": "vp run -r clean",
    "changeset": "changeset",
    "version": "changeset version && vp fmt",
    "release": "vp run -r build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5",
    "vite-plus": "1.1.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@11.18.0"
}
