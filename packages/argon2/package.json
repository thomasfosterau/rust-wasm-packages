{
  "name": "@thomasfosterau/argon2",
  "version": "0.0.0",
  "description": "argon2id password hashing for edge runtimes (Cloudflare Workers, Deno, browsers) — the RustCrypto argon2 crate compiled to WebAssembly, synchronous and dependency-free.",
  "keywords": [
    "argon2",
    "argon2id",
    "cloudflare-workers",
    "crypto",
    "edge",
    "password",
    "password-hashing",
    "phc",
    "rust",
    "wasm",
    "webassembly"
  ],
  "homepage": "https://github.com/thomasfosterau/rust-wasm-packages/tree/main/packages/argon2#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/rust-wasm-packages/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/rust-wasm-packages.git",
    "directory": "packages/argon2"
  },
  "files": [
    "dist",
    "src/lib.rs",
    "Cargo.toml",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist target src/wasm.generated.ts"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
